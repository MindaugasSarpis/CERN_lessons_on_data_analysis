# Visual QA workflow artifacts (see scripts/check-slides.mjs)
# slidev build --out resolves relative to the entry file's dir (lectures/content/)
.qa-dist/
lectures/content/.qa-dist/
.qa-shots/
.buildtest/

# Generated per-deck Slidev entries (regenerated by scripts/gen-entries.mjs)
lectures/content/deck.*.md

# Generated lecture index for the in-deck nav overlay (scripts/gen-entries.mjs)
lectures/content/public/lectures.json

# Vite landing bundle scratch output
landing/dist-assets/

# Per-agent isolated QA output dirs (parallel editing sessions)
.qa-dist-*/
.qa-shots-*/

# Superpowers SDD scratch (ledgers, briefs, review packages)
.superpowers/

# Claude Code git worktrees checked out inside the repo (never commit as gitlinks)
.claude/worktrees/
