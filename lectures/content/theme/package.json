{
  "name": "@slidev/theme-scienced",
  "version": "0.0.1",
  "description": "Scienced theme for Slidev",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": "latest",
    "slidev": ">51.0.0"
  },
  "slidev": {
    "defaults": {
      "titleTemplate": "%s · Best Research and Data Analysis Practices from CERN",
      "favicon": "/favicon.svg",
      "timer": "countdown",
      "transition": "fade",
      "fonts": {
        "sans": "Space Grotesk",
        "serif": "Space Grotesk",
        "mono": "Space Mono",
        "provider": "none",
        "italic": false,
        "weights": "400,500,600,700"
      }
    }
  },
  "dependencies": {
    "@slidev/types": "latest",
    "codemirror-theme-vars": "latest",
    "prism-theme-vars": "latest"
  }
}
