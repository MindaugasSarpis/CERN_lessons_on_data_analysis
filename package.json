{
  "name": "cern-lessons-on-data-analysis",
  "private": true,
  "description": "Best Research and Data Analysis Practices from CERN — lecture decks",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:combined": "slidev lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "dev:staging": "slidev lectures/content/staging.md",
    "build": "node scripts/build-all.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "build:landing:assets": "vite build --config landing/vite.config.mjs",
    "figures": "python3 figures/src/build.py",
    "figures:lhcb": "python3 scripts/gen-lhcb-figures.py",
    "build:combined": "slidev build lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "export": "slidev export lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "qa": "node scripts/qa-all.mjs",
    "qa:shots": "node scripts/qa-all.mjs --shots",
    "timing": "node scripts/timing-report.mjs",
    "timing:check": "node scripts/timing-report.mjs --check",
    "videos:sync": "python3 scripts/videos.py sync",
    "videos:fetch": "python3 scripts/videos.py fetch",
    "videos:encode": "python3 scripts/videos.py encode",
    "videos:publish": "python3 scripts/videos.py publish",
    "videos:check": "python3 scripts/videos.py check"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "slidev-addon-python-runner": "^0.1.3"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "mermaid": "^11.12.0",
    "playwright-chromium": "^1.56.1",
    "three": "^0.185.1",
    "vite": "^8.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright-chromium"
    ]
  }
}
