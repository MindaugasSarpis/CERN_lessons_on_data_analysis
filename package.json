{
  "name": "cern-lessons-on-data-analysis",
  "private": true,
  "description": "Best Research and Data Analysis Practices from CERN — lecture decks",
  "scripts": {
    "dev": "slidev lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "dev:staging": "slidev lectures/content/staging.md",
    "dev:lecture": "slidev",
    "dev:deck": "node scripts/gen-entries.mjs && slidev lectures/content/deck.$npm_config_slug.md",
    "build": "node scripts/build-all.mjs",
    "build:combined": "slidev build lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "export": "slidev export lectures/content/best_research_and_data_analysis_practices_from_CERN.md",
    "qa": "node scripts/qa-all.mjs",
    "qa:shots": "node scripts/qa-all.mjs --shots",
    "qa:combined": "slidev build lectures/content/best_research_and_data_analysis_practices_from_CERN.md --out .qa-dist && node scripts/check-slides.mjs lectures/content/.qa-dist",
    "videos:sync": "python3 scripts/videos.py sync",
    "videos:encode": "python3 scripts/videos.py encode",
    "videos:publish": "python3 scripts/videos.py publish",
    "videos:check": "python3 scripts/videos.py check"
  },
  "dependencies": {
    "@slidev/cli": "^52.14.2",
    "slidev-addon-python-runner": "^0.1.3"
  },
  "devDependencies": {
    "mermaid": "^11.12.0",
    "playwright-chromium": "^1.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright-chromium"
    ]
  }
}
