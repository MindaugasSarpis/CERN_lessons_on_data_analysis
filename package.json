{
  "name": "cern-lessons-on-data-analysis",
  "private": true,
  "description": "Lecture slides for Lessons on Data Analysis from CERN",
  "scripts": {
    "dev": "slidev lectures/content/lessons_on_data_analysis_from_CERN.md",
    "dev:staging": "slidev lectures/content/staging.md",
    "dev:lecture": "slidev",
    "build": "slidev build lectures/content/lessons_on_data_analysis_from_CERN.md",
    "export": "slidev export lectures/content/lessons_on_data_analysis_from_CERN.md",
    "qa:build": "slidev build lectures/content/lessons_on_data_analysis_from_CERN.md --out .qa-dist",
    "qa:overflow": "node scripts/check-slides.mjs lectures/content/.qa-dist",
    "qa:shots": "node scripts/check-slides.mjs lectures/content/.qa-dist --shots .qa-shots",
    "qa": "pnpm qa:build && node scripts/check-slides.mjs lectures/content/.qa-dist --shots .qa-shots",
    "videos:sync": "python3 scripts/videos.py sync",
    "videos:encode": "python3 scripts/videos.py encode",
    "videos:publish": "python3 scripts/videos.py publish",
    "videos:check": "python3 scripts/videos.py check"
  },
  "dependencies": {
    "@slidev/cli": "^52.14.2",
    "slidev-addon-python-runner": "^0.1.3"
  },
  "devDependencies": {
    "mermaid": "^11.12.0",
    "playwright-chromium": "^1.56.1"
  }
}
